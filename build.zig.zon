// SPDX-License-Identifier: BSD-3-Clause

.{
    .name = .fluxion_engine,
    .version = "0.3.1",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x2e5b6a99e50b4a48,
    // Every one pinned to a pushed commit, so `zig fetch` builds this
    // anywhere and not only beside the other repositories. A change pushed to
    // one of them reaches the engine when its pin moves:
    //   zig fetch --save=fluxion_rhi git+https://github.com/kisstp2006/fluxion-rhi#<commit>
    .dependencies = .{
        // The world, and everything in it. An entity is a thing in the scene,
        // with no inheritance and no virtual call.
        .fluxion_ecs = .{
            .url = "git+https://github.com/kisstp2006/fluxion-ecs#428a05a0799a257c52455df031918fdbf234fad0",
            .hash = "fluxion_ecs-0.1.0-YgvFeBkQAgDtQksXV9YleCjUaYm1HddX7S9Oowj2LWhP",
        },

        // One way to draw, on whichever API the machine has. Every layer -
        // the 3D one that is not written yet, the 2D one, the interface -
        // goes through this and through nothing else.
        .fluxion_rhi = .{
            .url = "git+https://github.com/kisstp2006/fluxion-rhi#b72b27d8cbc7c8c90b59fbdc943f17d3d33baea1",
            .hash = "fluxion_rhi-0.1.0--pvwDxhVEACf-YYWe-9zo6ymUk3TG4WsJjg5EItOBTrK",
        },

        // Windows, input and the event loop. A library may not depend on
        // this; an engine is exactly the thing that may, because opening the
        // window is its job.
        .fluxion_platform = .{
            .url = "git+https://github.com/kisstp2006/fluxion-platform#7f6990aef6d5c2a3f56bfb76582e6e55563da7c5",
            .hash = "fluxion_platform-0.1.0-WsOjUZdGGQBbA31UoS_op4pisjc8pza_GUuOx3xKy8y0",
        },

        // The interface layer: the layout `.ui` systems declare into, and the
        // renderer that draws it over the 2D layer.
        .fluxion_ui = .{
            .url = "git+https://github.com/kisstp2006/fluxion-ui#d57e5e3e90f3750fa442376ff37800c556cb66cb",
            .hash = "fluxion_ui-0.1.0-lw4Ws1xsEADjTQAoU4DyCeTJwBy3PqwfMZLXqQONMQ2e",
        },

        // What a texture is read from. A sprite atlas is a PNG on a disc.
        .fluxion_image = .{
            .url = "git+https://github.com/kisstp2006/fluxion-image#9ff412f8f52e6f1f4a11ec9243d3b838dc2707fd",
            .hash = "fluxion_image-0.1.0-fyJkdX63AgAIqyVQwGugPiHxv-Gpnghf9wpRLAqoBZZf",
        },

        // The sprite shader, written once and emitted as GLSL and as HLSL.
        // Without this the same shader would be in this repository twice, in
        // two languages, drifting apart.
        .fluxion_shader = .{
            .url = "git+https://github.com/kisstp2006/fluxion-shader#881f930e8ce42470e7a1ebf2f2fe4f1ee31de22c",
            .hash = "fluxion_shader-0.1.0-FqFMEr_2BwDkyRgbURZ7NmhleGbrBZb8X1jq7VMQ5nTz",
        },

        // Projections and matrices, and the one type that knows OpenGL's
        // clip space from Direct3D's.
        //
        // **The commit every package names.** `Device.clip()` returns a
        // `math.Clip` and `math.orthographic` takes one, so the two have to
        // be the *same* type - and a package is identified by what it holds.
        // Another commit here than the one inside `fluxion-rhi` would be two
        // copies of one library, and the compiler would say
        // "expected type 'proj.Clip', found 'proj.Clip'", which is the most
        // confusing message in Zig and always means this.
        .fluxion_math = .{
            .url = "git+https://github.com/kisstp2006/fluxion-math#92afdbddbf930369265d24136402c7eb5dd8f70e",
            .hash = "fluxion_math-0.1.0-dfpZBeNUBAAwUMriLKaOTRBWGFmfY53_jyYuMUxkPYek",
        },

        // TrueType, rasterised into the glyph atlas the 2D pass draws text
        // from.
        .fluxion_font = .{
            .url = "git+https://github.com/kisstp2006/fluxion-font#f666e62f498e5bfe04361c7f1bf6531334a51dbf",
            .hash = "fluxion_font-0.1.0-f3pT4rn1AwBbbEom4emICxRn1vGPQvsRhUc0_lCawLB8",
        },

        // Lines, shapes and text over the world, for looking at what a game
        // is doing: `app.debug`. Its renderer is drawn after the 2D pass, and
        // built by `build.zig` from its source with this package's rhi.
        .fluxion_debugdraw = .{
            .url = "git+https://github.com/kisstp2006/fluxion-debugdraw#9d30afc987f098eaf69b23ca71c797944a292922",
            .hash = "fluxion_debugdraw-0.1.0--_MjkjojAgAbfc9V4OwOsNLm-SE1Bq4A_S7s3j785_aE",
        },

        // What a scene is written in: JSON to read and diff, or CBOR, the
        // same values in fewer bytes.
        .fluxion_json = .{
            .url = "git+https://github.com/kisstp2006/fluxion-json#5b156eea39ad6f1ad1642c971008a0bbbbd21c0f",
            .hash = "fluxion_json-0.1.0-sFlLPa1yBQCYVZD-64nMnRtnhjH6P3xbnq1ftDyIs1DB",
        },

        // Rigid bodies, stepped in `.fixed` on the same scheduler as the
        // queries: `fluxion-physics` pins `fluxion-jobs` where `fluxion-ecs`
        // does, so the two share one `Jobs`.
        .fluxion_physics = .{
            .url = "git+https://github.com/kisstp2006/fluxion-physics#764bcc0ff36f48f3ca6ace8c16a6d6890366538b",
            .hash = "fluxion_physics-0.1.0-dovcrqU9CACijwbA2xjLhL7M-TaTy4oV1DikEo3pRhbJ",
        },

        // The components and the engine's calls, described at run time: what
        // an editor's inspector reads and writes, and what a console calls by
        // name. Its fluxion-json is the one above, so its JSON is the scenes'.
        .fluxion_reflect = .{
            .url = "git+https://github.com/kisstp2006/fluxion-reflect#2f48e6ef8e44a55039cdbd8cbbd3521f344cb8f8",
            .hash = "fluxion_reflect-0.1.0-Aw2l_2DGBQAt1GqJ0oVM7f-9xEwagzceO1A2F4mfDKVI",
        },
        // Flux, the scripting language: one VM on the App for a game that
        // calls `useScripts`, and a `Script` component per entity. Its own
        // fluxion-reflect and fluxion-json are pinned where these are, so a
        // `reflect.Value` is one type across the two.
        .fluxion_script = .{
            .url = "git+https://github.com/kisstp2006/fluxion-script#fca8a75be1a6fe41287b92105ee4d0c3bacfdb43",
            .hash = "fluxion_script-0.1.0-rt2DKsweFQAyreDxLgtjcGtESSxRxJUXS-4PqP0ZQAtg",
        },
        // Web requests: a script's `web` global, each request on a thread of
        // its own and its answer handed over once a frame.
        .fluxion_net = .{
            .url = "git+https://github.com/kisstp2006/fluxion-net#abe87f877ca8d8d8a430efaf60d0f7e303f00b93",
            .hash = "fluxion_net-0.1.0-VdxHa7GEAACHCcA1rVNM29oWqEjapk5lnCKRrWveWWnY",
        },

        // Generational handles: what the asset tables hand out, and what a
        // component holds instead of a pointer. The commit every package
        // names, for the same reason as the maths above - `fluxion-rhi`'s
        // resource handles are this package's.
        .fluxion_id = .{
            .url = "git+https://github.com/kisstp2006/fluxion-id#a52c29dfe5ac0a49a5d5469cdc1a4fb96b799ccc",
            .hash = "fluxion_id-0.1.0--9Hv-nGFAQAW36SvJvMB6L1nUNErZzh7JC0-nRPlrotw",
        },

        // Sound: the mixer graph, its decoders and the sound devices, C++
        // compiled by Zig. Its fluxion-id is pinned where this one is, so a
        // clip's handle is one type.
        .fluxion_audio = .{
            .url = "git+https://github.com/kisstp2006/fluxion-audio#76a68d94af5270db01172b6544e047365efa1533",
            .hash = "fluxion_audio-0.1.0-uP5dNwWuBwBs78OqhZsX0OA7tGzvNRZmA6a2QsqH9mej",
        },

        // Packs: a shipped game's files in one, sealed and signed if it
        // asks, which `res://` is read out of.
        .fluxion_vfs = .{
            .url = "git+https://github.com/kisstp2006/fluxion-vfs#185e749d9e238f8460db1aeff57b5f884b2bb6eb",
            .hash = "fluxion_vfs-0.1.0-L2GtldS6AwCPxotzolOY8cFvMvh90kx5m0t4jGS75VvD",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "runtime",
        "tools",
        "examples",
        "README.md",
        "LICENSE",
    },
}
